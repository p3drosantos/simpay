{
  "swagger": "2.0",
  "info": {
    "title": "Simpay API",
    "description": "API for Simpay that allows users to buy tickets for events",
    "version": "1.0.0"
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Bearer token"
    }
  },
  "paths": {
    "/users": {
      "post": {
        "summary": "Create user",
        "tags": ["User"],
        "parameters": [
          {
            "name": "body",
            "required": true,
            "in": "body",
            "schema": {
              "$ref": "#/definitions/CreateUserParams"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created"
          },
          "400": {
            "description": "Invalid params"
          },
          "409": {
            "description": "User already exists"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "summary": "Login user",
        "tags": ["Auth"],
        "parameters": [
          {
            "name": "body",
            "required": true,
            "in": "body",
            "schema": {
              "$ref": "#/definitions/LoginUserParams"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User logged in",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "400": {
            "description": "Invalid params"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/me/tickets": {
      "get": {
        "summary": "List authenticated user's tickets",
        "description": "Returns all tickets purchased by the authenticated user, including event details.",
        "tags": ["User"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Tickets found",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/UserTicketResponse"
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/events": {
      "post": {
        "summary": "Create event",
        "tags": ["Event"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "event",
            "required": true,
            "in": "body",
            "schema": {
              "$ref": "#/definitions/CreateEventParams"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Event created",
            "schema": {
              "$ref": "#/definitions/EventResponse"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User not found"
          },
          "400": {
            "description": "Invalid params"
          },
          "409": {
            "description": "Event already exists"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "get": {
        "summary": "Get all events",
        "tags": ["Event"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Events found",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/EventResponse"
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/events/{id}": {
      "get": {
        "summary": "Get event by id",
        "tags": ["Event"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Event found",
            "schema": {
              "$ref": "#/definitions/EventResponse"
            }
          },
          "400": {
            "description": "Invalid event ID"
          },
          "404": {
            "description": "Event not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete event",
        "tags": ["Event"],

        "security": [
          {
            "BearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],

        "responses": {
          "200": {
            "description": "Event deleted",
            "schema": {
              "$ref": "#/definitions/EventResponse"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "400": {
            "description": "Invalid event ID"
          },
          "404": {
            "description": "Event not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "summary": "Update event",
        "tags": ["Event"],

        "security": [
          {
            "BearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/UpdateEventParams"
            }
          }
        ],

        "responses": {
          "200": {
            "description": "Event updated",
            "schema": {
              "$ref": "#/definitions/EventResponse"
            }
          },
          "400": {
            "description": "Invalid params"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Event not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/events/{eventId}/tickets": {
      "post": {
        "summary": "Buy ticket",
        "tags": ["Ticket"],

        "security": [
          {
            "BearerAuth": []
          }
        ],

        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BuyTicketParams"
            }
          }
        ],

        "responses": {
          "201": {
            "description": "Ticket created",
            "schema": {
              "$ref": "#/definitions/TicketResponse"
            }
          },

          "400": {
            "description": "Invalid params"
          },

          "401": {
            "description": "Unauthorized"
          },
          "402": {
            "description": "Payment required"
          },
          "422": {
            "description": "Ticket unavailable or event sold out"
          },

          "403": {
            "description": "Only customers can buy tickets"
          },

          "404": {
            "description": "User or event not found"
          },

          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/webhook/stripe": {
      "post": {
        "consumes": ["application/json"],
        "summary": "Stripe webhook",
        "tags": ["Webhook"],
        "description": "Endpoint called by Stripe. Receives raw request body and validates the stripe-signature header to confirm payment events.",
        "parameters": [
          {
            "name": "stripe-signature",
            "in": "header",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": false,
            "schema": {
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Webhook processed"
          }
        }
      }
    }
  },
  "definitions": {
    "CreateUserParams": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "email": {
          "type": "string",
          "example": "Jhon@example.com"
        },
        "password": {
          "type": "string",
          "example": "password123"
        },
        "role": {
          "type": "string",
          "example": "customer"
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },
        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "email": {
          "type": "string",
          "example": "Jhon@example.com"
        },
        "password": {
          "type": "string",
          "example": "password123"
        },
        "role": {
          "type": "string",
          "example": "customer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    },
    "UserWithoutPassword": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },

        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "email": {
          "type": "string",
          "example": "Jhon@example.com"
        },
        "role": {
          "type": "string",
          "example": "customer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    },
    "LoginUserParams": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "user": {
          "$ref": "#/definitions/UserWithoutPassword"
        }
      }
    },
    "CreateEventParams": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "My Event"
        },
        "maxTickets": {
          "type": "integer",
          "example": 100
        },
        "ticketPriceInCents": {
          "type": "integer",
          "example": 100
        },
        "longitude": {
          "type": "number",
          "example": 0
        },
        "latitude": {
          "type": "number",
          "example": 0
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    },
    "EventResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },
        "ownerId": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },
        "name": {
          "type": "string",
          "example": "My Event"
        },
        "maxTickets": {
          "type": "integer",
          "example": 100
        },
        "ticketPriceInCents": {
          "type": "integer",
          "example": 100
        },
        "longitude": {
          "type": "number",
          "example": 0
        },
        "latitude": {
          "type": "number",
          "example": 0
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    },
    "UpdateEventParams": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "New name"
        },
        "ticketPriceInCents": {
          "type": "integer",
          "example": 500
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    },
    "TicketResponse": {
      "type": "object",
      "properties": {
        "checkoutUrl": {
          "type": "string",
          "example": "https://checkout.stripe.com/checkout/123"
        },
        "ticketId": {
          "type": "string",
          "example": "123"
        }
      }
    },
    "BuyTicketParams": {
      "type": "object",
      "properties": {
        "quantity": {
          "type": "integer",
          "example": 2
        }
      }
    },
    "EventSummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },
        "name": {
          "type": "string",
          "example": "My Event"
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    },
    "UserTicketResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },
        "quantity": {
          "type": "integer",
          "example": 2
        },
        "totalPriceInCents": {
          "type": "integer",
          "example": 200
        },
        "status": {
          "type": "string",
          "example": "paid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        },
        "event": {
          "$ref": "#/definitions/EventSummary"
        }
      }
    }
  }
}
