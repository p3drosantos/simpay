{
  "swagger": "2.0",
  "info": {
    "title": "Simpay API",
    "description": "API for Simpay that allows users to buy tickets for events",
    "version": "1.0.0"
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header"
    }
  },
  "paths": {
    "/users": {
      "post": {
        "summary": "Create user",
        "tags": ["User"],
        "parameters": [
          {
            "name": "user",
            "required": true,
            "in": "body",
            "schema": {
              "$ref": "#/definitions/CreateUserParams"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "User created"
          },
          "400": {
            "description": "Invalid params"
          },
          "409": {
            "description": "User already exists"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/users/login": {
      "post": {
        "summary": "Login user",
        "tags": ["Auth"],
        "parameters": [
          {
            "name": "body",
            "required": true,
            "in": "body",
            "schema": {
              "$ref": "#/definitions/LoginUserParams"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User logged in",
            "schema": {
              "$ref": "#/definitions/LoginResponse"
            }
          },
          "400": {
            "description": "Invalid params"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/events": {
      "post": {
        "summary": "Create event",
        "tags": ["Event"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "event",
            "required": true,
            "in": "body",
            "schema": {
              "$ref": "#/definitions/CreateEventParams"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Event created",
            "schema": {
              "$ref": "#/definitions/EventResponse"
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User not found"
          },
          "400": {
            "description": "Invalid params"
          },
          "409": {
            "description": "Event already exists"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "get": {
        "summary": "Get all events",
        "tags": ["Event"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Events found",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/EventResponse"
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "definitions": {
    "CreateUserParams": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "email": {
          "type": "string",
          "example": "Jhon@example.com"
        },
        "password": {
          "type": "string",
          "example": "password123"
        },
        "role": {
          "type": "string",
          "example": "customer"
        }
      }
    },
    "User": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },
        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "email": {
          "type": "string",
          "example": "Jhon@example.com"
        },
        "password": {
          "type": "string",
          "example": "password123"
        },
        "role": {
          "type": "string",
          "example": "customer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    },
    "UserWithoutPassword": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },

        "name": {
          "type": "string",
          "example": "John Doe"
        },
        "email": {
          "type": "string",
          "example": "Jhon@example.com"
        },
        "role": {
          "type": "string",
          "example": "customer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    },
    "LoginUserParams": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "LoginResponse": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        },
        "user": {
          "$ref": "#/definitions/UserWithoutPassword"
        }
      }
    },
    "CreateEventParams": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "My Event"
        },
        "maxTickets": {
          "type": "integer",
          "example": 100
        },
        "ticketPriceInCents": {
          "type": "integer",
          "example": 100
        },
        "longitude": {
          "type": "number",
          "example": 0
        },
        "latitude": {
          "type": "number",
          "example": 0
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    },
    "EventResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },
        "ownerId": {
          "type": "string",
          "example": "e299b4d5-c6e9-4a0a-a133-3a86f9daa3d5"
        },
        "name": {
          "type": "string",
          "example": "My Event"
        },
        "max_tickets": {
          "type": "integer",
          "example": 100
        },
        "ticket_price_in_cents": {
          "type": "integer",
          "example": 100
        },
        "longitude": {
          "type": "number",
          "example": 0
        },
        "latitude": {
          "type": "number",
          "example": 0
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "example": "2027-01-01T00:00:00.000Z"
        }
      }
    }
  }
}
